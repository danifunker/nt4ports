diff -ruN --text a/PowerEditor/src/npp_nt4compat.h b/PowerEditor/src/npp_nt4compat.h
--- a/PowerEditor/src/npp_nt4compat.h	1969-12-31 19:00:00.000000000 -0500
+++ b/PowerEditor/src/npp_nt4compat.h	2026-11-06 13:13:19.387177105 -0500
@@ -0,0 +1,46 @@
+/* npp_nt4compat.h: forced include (/FI) for building Notepad++ 3.3 with VC6
+ * and NT 4.0-era headers, no later SDK. */
+#ifndef NPP_NT4COMPAT_H
+#define NPP_NT4COMPAT_H
+#ifndef _WIN32_IE
+#define _WIN32_IE 0x0400
+#endif
+/* Some sources include shlwapi.h before anything that includes windows.h. */
+#include <windows.h>
+/* VC6 keeps a for-loop variable in the enclosing scope. */
+#if defined(_MSC_VER) && _MSC_VER < 1300
+#define for if (0) {} else for
+#endif
+#ifndef WS_EX_LAYOUTRTL
+#define WS_EX_LAYOUTRTL 0x00400000L
+#endif
+#ifndef BTNS_BUTTON
+#define BTNS_BUTTON TBSTYLE_BUTTON
+#define BTNS_SEP TBSTYLE_SEP
+#define BTNS_AUTOSIZE TBSTYLE_AUTOSIZE
+#endif
+#ifndef TBSTYLE_AUTOSIZE
+#define TBSTYLE_AUTOSIZE 0x0010
+#endif
+#ifndef TCS_EX_FLATSEPARATORS
+#define TCS_EX_FLATSEPARATORS 0x00000001
+#endif
+#ifdef NPP_NT4_HEADERS
+/* NT 4.0's own comctl32 can't add icons to a 32-bit image list: ImageList_AddIcon
+ * returns -1, leaving toolbars and tabs without images. */
+#define NPP_ILC_COLOR ILC_COLOR16
+typedef struct tagNMMOUSE {
+	NMHDR hdr;
+	DWORD dwItemSpec;
+	DWORD dwItemData;
+	POINT pt;
+	DWORD dwHitInfo;
+} NMMOUSE, *LPNMMOUSE;
+#endif
+#ifndef NPP_ILC_COLOR
+#define NPP_ILC_COLOR ILC_COLOR32
+#endif
+#ifndef INVALID_FILE_ATTRIBUTES
+#define INVALID_FILE_ATTRIBUTES ((DWORD)-1)
+#endif
+#endif
