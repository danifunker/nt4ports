+// Free functions: Visual C++ 4 would compile the members for types with no == or <.
+template <class V, class T>
+int VecFind(const V &v, const T &item)
+{
+  for (int i = 0; i < v.Size(); i++)
+    if (item == v[i])
+      return i;
+  return -1;
+}
+
+template <class V, class T>
+int VecFindInSorted2(const V &v, const T &item, int left, int right)
+{
+  while (left != right)
+  {
+    int mid = (left + right) / 2;
+    if (item == v[mid])
+      return mid;
+    if (item < v[mid])
+      right = mid;
+    else
+      left = mid + 1;
+  }
+  return -1;
+}
+
+template <class V, class T>
+int VecFindInSorted(const V &v, const T &item)
+  { return VecFindInSorted2(v, item, 0, v.Size()); }
+
+template <class V, class T>
+int VecAddToUniqueSorted(V &v, const T &item)
+{
+  int left = 0, right = v.Size();
+  while (left != right)
+  {
+    int mid = (left + right) / 2;
+    if (item == v[mid])
+      return mid;
+    if (item < v[mid])
+      right = mid;
+    else
+      left = mid + 1;
+  }
+  v.Insert(right, item);
+  return right;
+}
+
+template <class V, class T>
+int VecAddToSorted(V &v, const T &item)
+{
+  int left = 0, right = v.Size();
+  while (left != right)
+  {
+    int mid = (left + right) / 2;
+    if (item == v[mid])
+    {
+      right = mid + 1;
+      break;
+    }
+    if (item < v[mid])
+      right = mid;
+    else
+      left = mid + 1;
+  }
+  v.Insert(right, item);
+  return right;
+}
+
+template <class T>
+struct CVecCompare
+{
+  static int Compare(void *const *a1, void *const *a2, void * /* param */)
+    { return MyCompare(*(*((const T **)a1)), *(*((const T **)a2))); }
+};
+
+template <class T>
+void VecSort(CObjectVector<T> &v) { v.Sort(CVecCompare<T>::Compare, 0); }
+
 #endif
