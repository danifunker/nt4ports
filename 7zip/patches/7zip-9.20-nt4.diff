+// A free function: Visual C++ 4 has no member templates.
+template <class TDecoder, class TBitDecoder>
+UInt32 HuffDecodeSymbol(TDecoder &d, TBitDecoder *bitStream)
+{
+  int numBits;
+  UInt32 value = bitStream->GetValue(d.kMaxBits);
+  if (value < d.m_Limits[kNumTableBits])
+    numBits = d.m_Lengths[value >> (d.kMaxBits - kNumTableBits)];
+  else
+    for (numBits = kNumTableBits + 1; value >= d.m_Limits[numBits]; numBits++);
+  bitStream->MovePos(numBits);
+  UInt32 index = d.m_Positions[numBits] +
+    ((value - d.m_Limits[numBits - 1]) >> (d.kMaxBits - numBits));
+  if (index >= (UInt32)d.kSymbols)
+    // throw CDecoderException(); // test it
+    return 0xFFFFFFFF;
+  return d.m_Symbols[index];
+}
