// set for the NT 4.0 build of FileZilla: see fzstl.h and fztree.h. Ordered by operator<.
#ifndef FZSTL_SET
#define FZSTL_SET
#include "fztree.h"

namespace std {

template <class K> struct _SetKey {
	static const K &key(const K &v) { return v; }
};

template <class K> class set {
public:
	typedef K key_type;
	typedef K value_type;
	typedef size_t size_type;
	typedef _Tree<K, K, _SetKey<K> > tree;

	// As in the standard, the elements of a set can't be changed in place.
	class const_iterator {
	public:
		_TreeLink *_x;
		const _TreeBase *_t;
		const_iterator(_TreeLink *x = 0, const _TreeBase *t = 0) : _x(x), _t(t) {}
		const K &operator*() const { return tree::_val(_x); }
		const K *operator->() const { return &tree::_val(_x); }
		const_iterator &operator++() { _x = _TreeBase::_next(_x); return *this; }
		const_iterator operator++(int) { const_iterator t = *this; _x = _TreeBase::_next(_x); return t; }
		const_iterator &operator--() { _x = _t->_prev(_x); return *this; }
		const_iterator operator--(int) { const_iterator t = *this; _x = _t->_prev(_x); return t; }
		bool operator==(const const_iterator &o) const { return _x == o._x; }
		bool operator!=(const const_iterator &o) const { return _x != o._x; }
	};
	typedef const_iterator iterator;

	set() {}

	const_iterator begin() const { return const_iterator(_t._first(), &_t); }
	const_iterator end() const { return const_iterator(0, &_t); }
	size_type size() const { return _t.n; }
	bool empty() const { return _t.n == 0; }

	const_iterator find(const K &k) const { return const_iterator(_t._find(k), &_t); }
	size_type count(const K &k) const { return _t._find(k) ? 1 : 0; }
	const_iterator lower_bound(const K &k) const { return const_iterator(_t._bound(k, 0), &_t); }
	const_iterator upper_bound(const K &k) const { return const_iterator(_t._bound(k, 1), &_t); }

	pair<const_iterator, bool> insert(const K &v)
	{
		int added;
		_TreeLink *x = _t._insert(v, &added);
		return pair<const_iterator, bool>(const_iterator(x, &_t), added != 0);
	}
	const_iterator insert(const_iterator, const K &v) { return insert(v).first; }
	void erase(const_iterator i) { _t._erase(i._x); }
	void erase(const_iterator first, const_iterator last)
	{
		while (first != last)
			erase(first++);
	}
	size_type erase(const K &k)
	{
		_TreeLink *x = _t._find(k);
		if (!x)
			return 0;
		_t._erase(x);
		return 1;
	}
	void clear() { _t._clear(); }
	void swap(set &o) { _t._swap(o._t); }

private:
	tree _t;
};

}

#endif
