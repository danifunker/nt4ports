/////////////////////////////////////////////////////////////////////////////
//
// Bitmap
//

IDR_MAINFRAME           BITMAP                  "res\\Toolbar.bmp"

/////////////////////////////////////////////////////////////////////////////
//
// Toolbar
//

IDR_MAINFRAME TOOLBAR  16, 16
BEGIN
    BUTTON      ID_SITEMANAGER
    SEPARATOR
    BUTTON      ID_SHOWTREE
    BUTTON      ID_SHOWREMOTETREE
    BUTTON      ID_SHOWQUEUE
    BUTTON      ID_VIEW_MESSAGELOG
    SEPARATOR
    BUTTON      ID_TOOLBAR_REFRESH
    BUTTON      ID_PROCESS_QUEUE
    BUTTON      ID_CANCELBUTTON
    BUTTON      ID_TOOLBAR_DISCONNECT
    BUTTON      ID_TOOLBAR_RECONNECT
    SEPARATOR
    BUTTON      ID_HELPMENU_CONTENTS
END


/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MAINFRAME MENU 
BEGIN
    POPUP "&Fitxer"
    BEGIN
        MENUITEM "Ge&stor de llocs...\tCtrl+S", ID_SITEMANAGER
        MENUITEM "&Copia la connexió al Gestor de llocs", 
                                                ID_COPYTOSITEMANAGER
        MENUITEM "C&onnecta al lloc predeterminat", 
                                                ID_FILE_CONNECTTODEFAULTSITE
        MENUITEM SEPARATOR
        MENUITEM "&Reconnecta\tCtrl+R",         ID_TOOLBAR_RECONNECT
        MENUITEM "&Desconnecta\tCtrl+D",        ID_TOOLBAR_DISCONNECT
        MENUITEM SEPARATOR
        MENUITEM "Sortir",                      ID_APP_EXIT
    END
    POPUP "&Edita"
    BEGIN
        MENUITEM "&Configuració...",            ID_EDIT_SETTINGS
        MENUITEM "E&xportar configuració...",   ID_EDIT_EXPORTSETTINGS
        MENUITEM "&Importar configuració...",   ID_EDIT_IMPORTSETTINGS
    END
    POPUP "&Transferències"
    BEGIN
        POPUP "&Tipus de tranferències"
        BEGIN
            MENUITEM "&ASCII",                      ID_TYPEMENU_ASCII
            MENUITEM "&Binari",                     ID_TYPEMENU_BINARY
            MENUITEM "A&uto",                       ID_TYPEMENU_DETECT
        END
        POPUP "Configuració de sobreescritura de &fitxers"
        BEGIN
            MENUITEM "Pregunt&a",                   ID_OVERWRITEMENU_ASK
            MENUITEM SEPARATOR
            MENUITEM "S&obreescriu",                ID_OVERWRITEMENU_OVERWRITE

            MENUITEM "Sobreescr&iu si es més actual", 
                                                    ID_OVERWRITEMENU_OVERWRITEIFNEWER

            MENUITEM "&Continua",                   ID_OVERWRITEMENU_RESUME
            MENUITEM "A&nomena",                    ID_OVERWRITEMENU_RENAME
            MENUITEM "O&met",                       ID_OVERWRITEMENU_SKIP
        END
        MENUITEM SEPARATOR
        MENUITEM "&Transferència Manual...",    ID_MENU_TRANSFER_MANUALTRANSFER

    END
    POPUP "&Visualitza"
    BEGIN
        MENUITEM "Actualitza Vista\t     F5",   ID_TOOLBAR_REFRESH
        MENUITEM "Mostra fitxers ocults",       ID_MENU_VIEW_SHOWHIDDEN
        MENUITEM SEPARATOR
        MENUITEM "Barra d'eines",               ID_VIEW_TOOLBAR
        MENUITEM "Barra d'e&stat",              ID_VIEW_STATUS_BAR
        MENUITEM "Barra &Connexió Ràpida",      ID_VIEW_QUICKCONNECT_BAR
        MENUITEM SEPARATOR
        MENUITEM "Vista arbre &Local\tCtrl+T",  ID_SHOWTREE
        MENUITEM "Vista arbre Rem&ota",         ID_SHOWREMOTETREE
        MENUITEM "&Bitàcora",                   ID_VIEW_MESSAGELOG
        MENUITEM "Cua de tranferències",        ID_SHOWQUEUE
        MENUITEM SEPARATOR
        POPUP "Vista de la Llista Loc&al"
        BEGIN
            MENUITEM "&Detalls",                    ID_LOCALLISTSTYLE_REPORT
            MENUITEM "&Llista",                     ID_LOCALLISTSTYLE_LIST
            MENUITEM "&Icones grans",               ID_LOCALLISTSTYLE_ICON
            MENUITEM "I&cones petites",             ID_LOCALLISTSTYLE_SMALLICON

            MENUITEM SEPARATOR
            MENUITEM "Grandària Fitzer",            ID_VIEW_LOCALLISTVIEW_FILESIZE

            MENUITEM "&Tipus de Fitxer",            ID_VIEW_LOCALLISTVIEW_FILETYPE

            MENUITEM "Data de darrera &modificació", 
                                                    ID_VIEW_LOCALLISTVIEW_LASTMODIFIEDTIME

            MENUITEM SEPARATOR
            MENUITEM "Mo&stra Barra d'Estat",       ID_MENU_VIEW_LOCALLISTVIEW_STATUSBAR

            POPUP "Classifica per..."
            BEGIN
                MENUITEM "Nom de &Fitxer",              ID_MENU_VIEW_LOCALLISTVIEW_SORTBY_FILENAME

                MENUITEM "Grandària de Fitxer",         ID_MENU_VIEW_LOCALLISTVIEW_SORTBY_FILESIZE

                MENUITEM "&Tipus de fitxer",            ID_MENU_VIEW_LOCALLISTVIEW_SORTBY_FILETYPE

                MENUITEM "Darrera modificació",         ID_MENU_VIEW_LOCALLISTVIEW_SORTBY_LASTMODIFIED

                MENUITEM SEPARATOR
                MENUITEM "&Ascendent",                  ID_MENU_VIEW_LOCALLISTVIEW_SORTBY_ASCENDING

                MENUITEM "&Descendent",                 ID_MENU_VIEW_LOCALLISTVIEW_SORTBY_DESCENDING

            END
        END
        POPUP "Vista de Llista R&emota"
        BEGIN
            MENUITEM "&Detalls",                    ID_REMOTELISTSTYLE_REPORT

            MENUITEM "&Lista",                      ID_REMOTELISTSTYLE_LIST
            MENUITEM "&Icones grans",               ID_REMOTELISTSTYLE_ICON
            MENUITEM "I&cones petites",             ID_REMOTELISTSTYLE_SMALLICON

            MENUITEM SEPARATOR
            MENUITEM "Grandària de Fitxer",         ID_VIEW_REMOTELISTVIEW_FILESIZE

            MENUITEM "Tipus de fitxer",             ID_VIEW_REMOTELISTVIEW_FILETYPE

            MENUITEM "D&ata",                       ID_VIEW_REMOTELISTVIEW_DATE

            MENUITEM "Hora",                        ID_VIEW_REMOTELISTVIEW_TIME

            MENUITEM "&Permisos",                   ID_VIEW_REMOTELISTVIEW_PERMISSIONS

            MENUITEM "Pro&pietari / Grup",          ID_VIEW_REMOTELISTVIEW_OWNERGROUP

            MENUITEM SEPARATOR
            MENUITEM "Mostra barra d'e&stat",       ID_MENU_VIEW_REMOTELISTVIEW_STATUSBAR

            POPUP "Classifica per..."
            BEGIN
                MENUITEM "Nom de &fitxer",              ID_MENU_VIEW_REMOTELISTVIEW_SORTBY_FILENAME

                MENUITEM "Grandària de Fitxer",         ID_MENU_VIEW_REMOTELISTVIEW_SORTBY_FILESIZE

                MENUITEM "Tipus de fitxer",             ID_MENU_VIEW_REMOTELISTVIEW_SORTBY_FILETYPE

                MENUITEM "&Data / Hora",                ID_MENU_VIEW_REMOTELISTVIEW_SORTBY_DATETIME

                MENUITEM SEPARATOR
                MENUITEM "&Ascendent",                  ID_MENU_VIEW_REMOTELISTVIEW_SORTBY_ASCENDING

                MENUITEM "D&escendent",                 ID_MENU_VIEW_REMOTELISTVIEW_SORTBY_DESCENDING

            END
        END
    END
    POPUP "&Cua"
    BEGIN
        MENUITEM "&Processar Cua",              ID_MENU_QUEUE_PROCESSNOW
        MENUITEM "&Utilitza connexions múltiples", ID_MENU_QUEUE_USEMULTIPLE
        MENUITEM SEPARATOR
        MENUITEM "&Exporta...",                 ID_MENU_QUEUE_EXPORT
        MENUITEM "&Importa...",                 ID_MENU_QUEUE_IMPORT
    END
    POPUP "&Servidor"
    BEGIN
        MENUITEM "&Canvia contrasenya...",      ID_MENU_SERVER_CHANGEPASS
        MENUITEM "&Introdueix instrucció FTP...\tCtrl+F", 
                                                ID_MENU_SERVER_ENTERRAWCOMMAND

        MENUITEM "Copia &URL al porta-retalls", ID_MENU_SERVER_COPYURLTOCLIPBOARD

    END
    POPUP "&Ajuda"
    BEGIN
        MENUITEM "&Continguts...",              ID_HELPMENU_CONTENTS
        MENUITEM "Bu&scar...",                  ID_HELPMENU_SEARCH
        MENUITEM "Índex...",                    ID_HELPMENU_INDEX
        MENUITEM SEPARATOR
        MENUITEM "&Quant a...",                 ID_APP_ABOUT
    END
END

IDR_OUTPUTCONTEXT MENU 
BEGIN
    POPUP "OutputContext"
    BEGIN
        MENUITEM "&Introueix instrucció...",    ID_OUTPUTCONTEXT_ENTERCOMMAND

        MENUITEM SEPARATOR
        MENUITEM "C&opia al porta-retalls",     ID_OUTPUTCONTEXT_COPYTOCLIPBOARD

        MENUITEM "&Borra tots",                 ID_OUTPUTCONTEXT_CLEARALL
    END
END

IDR_FTPCONTEXTMENU MENU 
BEGIN
    POPUP "FtpContext"
    BEGIN
        MENUITEM "&Descàrrega",                 ID_FTPCONTEXT_DOWNLOAD
        MENUITEM "&Afegir a la cua",            ID_FTPCONTEXT_ADDTOQUEUE
        MENUITEM "Des&carrega com...",          ID_FTPCONTEXT_DOWNLOADAS
        MENUITEM SEPARATOR
        MENUITEM "&Obrir",                      ID_FTPCONTEXT_OPEN
        MENUITEM "&Veure / Editar",             ID_FTPCONTEXT_VIEWEDIT
        MENUITEM "&Crear Directori",            ID_FTPCONTEXT_CREATEDIR
        MENUITEM "&Esborrar",                   ID_FTPCONTEXT_DELETE
        MENUITEM "&Tornar a anomenar",          ID_FTPCONTEXT_RENAME
        MENUITEM "Atributs del &fitxer...",     ID_FTPCONTEXT_ATTRIBUTES
    END
END

IDR_LOCALCONTEXTMENU MENU 
BEGIN
    POPUP "LocalContext"
    BEGIN
        MENUITEM "&Puja",                       ID_LOCALCONTEXT_UPLOAD
        MENUITEM "&Afegir a la cua",            ID_LOCALCONTEXT_ADDTOQUEUE
        MENUITEM "Puja com...",                 ID_LOCALCONTEXT_UPLOADAS
        MENUITEM SEPARATOR
        MENUITEM "&Creu un directoti",          ID_LOCALCONTEXT_CREATEDIRECTORY

        MENUITEM SEPARATOR
        MENUITEM "&Obrir",                      ID_LOCALCONTEXT_OPEN
        MENUITEM "&Veure / Editar",             ID_LOCALCONTEXT_VIEWEDIT
        MENUITEM "&Esborrar",                   ID_LOCALCONTEXT_DELETE
        MENUITEM "&Tornar a anomenar",          ID_LOCALCONTEXT_RENAME
        MENUITEM "Propie&tats",                 ID_LOCALCONTEXT_PROPERTIES
    END
END

IDR_QUEUECONTEXTMENU MENU 
BEGIN
    POPUP "QueueContext"
    BEGIN
        MENUITEM "&Processa cua",               ID_QUEUECONTEXT_PROCESSQUEUE
        MENUITEM "&Treu de la cua",             ID_QUEUECONTEXT_REMOVEFROMQUEUE

        MENUITEM "Reseteja l'e&stat",           ID_QUEUECONTEXT_RESETSTATUS
        MENUITEM SEPARATOR
        MENUITEM "Paus&a",                      ID_QUEUECONTEXT_PAUSE
        MENUITEM "Continua",                    ID_QUEUECONTEXT_RESUME
        MENUITEM "&Anul·la",                    ID_QUEUECONTEXT_ABORT
        MENUITEM SEPARATOR
        MENUITEM "Mou &amunt",                  ID_QUEUECONTEXT_MOVEUP
        MENUITEM "Mou a&vall",                  ID_QUEUECONTEXT_MOVEDOWN
        MENUITEM "Mou al principi",             ID_QUEUECONTEXT_MOVETOTOP
        MENUITEM "Mou al final",                ID_QUEUECONTEXT_MOVETOBOTTOM
    END
END

IDR_SITEMANAGER MENU 
BEGIN
    POPUP "&Fitxer"
    BEGIN
        MENUITEM "&Importa",                    ID_SITEMANAGER_FILE_IMPORT
        POPUP "&Exporta..."
        BEGIN
            MENUITEM "com llista d'&URL",           ID_SITEMANAGER_FILE_EXPORT_ASURLLIST

            MENUITEM "amb tots els &detalls",       ID_SITEMANAGER_FILE_EXPORT_WITHALLDETAILS

        END
        MENUITEM SEPARATOR
        MENUITEM "Desa i surt",                 ID_SITEMANAGER_SAVEEXIT
    END
END

IDR_LOCALTREECONTEXTMENU MENU 
BEGIN
    POPUP "LocalTreeContext"
    BEGIN
        MENUITEM "&Puja",                       ID_LOCALTREECONTEXT_UPLOAD
        MENUITEM "&Afegeix a la cua",           ID_LOCALTREECONTEXT_ADDTOQUEUE

        MENUITEM "&Puja com...",                ID_LOCALTREECONTEXT_UPLOADAS
        MENUITEM SEPARATOR
        MENUITEM "&Esborra",                    ID_LOCALTREECONTEXT_DELETE
        MENUITEM "&Tornar a anomenar",          ID_LOCALTREECONTEXT_RENAME
    END
END

IDR_SYSTRAY_MENU MENU 
BEGIN
    POPUP "POPUP"
    BEGIN
        MENUITEM "&Restaura",                   ID_TRAY_RESTORE
        MENUITEM SEPARATOR
        MENUITEM "&Surt",                       ID_TRAY_EXIT
    END
END


