            MENUITEM "&Typ s˙boru",                 ID_VIEW_REMOTELISTVIEW_FILETYPE

            MENUITEM "D&·tum",                      ID_VIEW_REMOTELISTVIEW_DATE

            MENUITEM "&Cas",                        ID_VIEW_REMOTELISTVIEW_TIME

            MENUITEM "&Opr·vnenia",                 ID_VIEW_REMOTELISTVIEW_PERMISSIONS

            MENUITEM "&VlastnÌk / Skupina",         ID_VIEW_REMOTELISTVIEW_OWNERGROUP

            MENUITEM SEPARATOR
