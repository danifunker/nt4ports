            POPUP "Z&oradit podla..."
            BEGIN
                MENUITEM "&Mena",                       ID_MENU_VIEW_LOCALLISTVIEW_SORTBY_FILENAME

                MENUITEM "&Velkosti",                   ID_MENU_VIEW_LOCALLISTVIEW_SORTBY_FILESIZE

                MENUITEM "&Typu s˙boru",                ID_MENU_VIEW_LOCALLISTVIEW_SORTBY_FILETYPE

                MENUITEM "&Poslednej modifik·cie",      ID_MENU_VIEW_LOCALLISTVIEW_SORTBY_LASTMODIFIED

                MENUITEM SEPARATOR
                MENUITEM "&Vzostupne",                  ID_MENU_VIEW_LOCALLISTVIEW_SORTBY_ASCENDING

                MENUITEM "&Zostupne",                   ID_MENU_VIEW_LOCALLISTVIEW_SORTBY_DESCENDING

            END
        END
        POPUP "&Pohlad vzdialenÈho zoznamu"
        BEGIN
