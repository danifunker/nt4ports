/////////////////////////////////////////////////////////////////////////////
//
// Bitmap
//

IDR_MAINFRAME           BITMAP                  "res\\Toolbar.bmp"

/////////////////////////////////////////////////////////////////////////////
//
// Toolbar
//

IDR_MAINFRAME TOOLBAR  16, 16
BEGIN
    BUTTON      ID_SITEMANAGER
    SEPARATOR
    BUTTON      ID_SHOWTREE
    BUTTON      ID_SHOWREMOTETREE
    BUTTON      ID_SHOWQUEUE
    BUTTON      ID_VIEW_MESSAGELOG
    SEPARATOR
    BUTTON      ID_TOOLBAR_REFRESH
    BUTTON      ID_PROCESS_QUEUE
    BUTTON      ID_CANCELBUTTON
    BUTTON      ID_TOOLBAR_DISCONNECT
    BUTTON      ID_TOOLBAR_RECONNECT
    SEPARATOR
    BUTTON      ID_HELPMENU_CONTENTS
END


/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MAINFRAME MENU 
BEGIN
    POPUP "&Fil"
    BEGIN
        MENUITEM "&Site Manager...\tCtrl+S",    ID_SITEMANAGER
        MENUITEM "&Kopier tilkoblingen til Site Manager", 
                                                ID_COPYTOSITEMANAGER
        MENUITEM "K&oble til standard server",  ID_FILE_CONNECTTODEFAULTSITE
        MENUITEM SEPARATOR
        MENUITEM "Koble til på &ny",            ID_TOOLBAR_RECONNECT
        MENUITEM "Koble &fra",                  ID_TOOLBAR_DISCONNECT
        MENUITEM SEPARATOR
        MENUITEM "&Avslutt",                    ID_APP_EXIT
    END
    POPUP "&Endre"
    BEGIN
        MENUITEM "&Innstillinger...",           ID_EDIT_SETTINGS
        MENUITEM "E&ksporter innstillinger...", ID_EDIT_EXPORTSETTINGS
        MENUITEM "&Importer innstillinger...",  ID_EDIT_IMPORTSETTINGS
    END
    POPUP "&Overføring"
    BEGIN
        POPUP "&Overføringstype"
        BEGIN
            MENUITEM "&ASCII",                      ID_TYPEMENU_ASCII
            MENUITEM "&Binær",                      ID_TYPEMENU_BINARY
            MENUITEM "A&uto",                       ID_TYPEMENU_DETECT
        END
        POPUP "Filoverskrivings innstillinger"
        BEGIN
            MENUITEM "&Spør",                       ID_OVERWRITEMENU_ASK
            MENUITEM SEPARATOR
            MENUITEM "&Skriv over",                 ID_OVERWRITEMENU_OVERWRITE

            MENUITEM "Skriv over hvis &nyere",      ID_OVERWRITEMENU_OVERWRITEIFNEWER

            MENUITEM "&Fortsett (Resume)",          ID_OVERWRITEMENU_RESUME
            MENUITEM "&Gi nytt navn",               ID_OVERWRITEMENU_RENAME
            MENUITEM "&Hopp over",                  ID_OVERWRITEMENU_SKIP
        END
        MENUITEM SEPARATOR
        MENUITEM "&Manuell overføring...",      ID_MENU_TRANSFER_MANUALTRANSFER

    END
    POPUP "&Vis"
    BEGIN
        MENUITEM "&Oppdater visning\t     F5",  ID_TOOLBAR_REFRESH
        MENUITEM "Vis &skjulte filer",          ID_MENU_VIEW_SHOWHIDDEN
        MENUITEM SEPARATOR
        MENUITEM "&Verktøylinje",               ID_VIEW_TOOLBAR
        MENUITEM "&Statuslinje",                ID_VIEW_STATUS_BAR
        MENUITEM "Quick &Connect Bar",          ID_VIEW_QUICKCONNECT_BAR
        MENUITEM SEPARATOR
        MENUITEM "&Lokal sti visning\tCtrl+T",  ID_SHOWTREE
        MENUITEM "Server sti visning",          ID_SHOWREMOTETREE
        MENUITEM "&Meldingslogg",               ID_VIEW_MESSAGELOG
        MENUITEM "Overførings&kø",              ID_SHOWQUEUE
        MENUITEM SEPARATOR
        POPUP "Lo&kal visning"
        BEGIN
            MENUITEM "&Detaljer",                   ID_LOCALLISTSTYLE_REPORT
            MENUITEM "&Liste",                      ID_LOCALLISTSTYLE_LIST
            MENUITEM "Store &ikoner",               ID_LOCALLISTSTYLE_ICON
            MENUITEM "Små i&koner",                 ID_LOCALLISTSTYLE_SMALLICON

            MENUITEM SEPARATOR
            MENUITEM "Filest&ørrelse",              ID_VIEW_LOCALLISTVIEW_FILESIZE

            MENUITEM "Fil&type",                    ID_VIEW_LOCALLISTVIEW_FILETYPE

            MENUITEM "Sist &modifisert tid",        ID_VIEW_LOCALLISTVIEW_LASTMODIFIEDTIME

            MENUITEM SEPARATOR
            MENUITEM "&Vis statuslinje",            ID_MENU_VIEW_LOCALLISTVIEW_STATUSBAR

            POPUP "S&orter etter..."
            BEGIN
                MENUITEM "&Filnavn",                    ID_MENU_VIEW_LOCALLISTVIEW_SORTBY_FILENAME

                MENUITEM "Filst&ørrelse",               ID_MENU_VIEW_LOCALLISTVIEW_SORTBY_FILESIZE

                MENUITEM "File&type",                   ID_MENU_VIEW_LOCALLISTVIEW_SORTBY_FILETYPE

                MENUITEM "&Sist modifisert",            ID_MENU_VIEW_LOCALLISTVIEW_SORTBY_LASTMODIFIED

                MENUITEM SEPARATOR
                MENUITEM "Ø&kende",                     ID_MENU_VIEW_LOCALLISTVIEW_SORTBY_ASCENDING

                MENUITEM "&Synkene",                    ID_MENU_VIEW_LOCALLISTVIEW_SORTBY_DESCENDING

            END
        END
        POPUP "S&erver visning"
        BEGIN
            MENUITEM "&Detaljer",                   ID_REMOTELISTSTYLE_REPORT

            MENUITEM "&Liste",                      ID_REMOTELISTSTYLE_LIST
            MENUITEM "Store &ikoner",               ID_REMOTELISTSTYLE_ICON
            MENUITEM "Små i&koner",                 ID_REMOTELISTSTYLE_SMALLICON

            MENUITEM SEPARATOR
            MENUITEM "File&størrelse",              ID_VIEW_REMOTELISTVIEW_FILESIZE

            MENUITEM "File&type",                   ID_VIEW_REMOTELISTVIEW_FILETYPE

            MENUITEM "&Dato",                       ID_VIEW_REMOTELISTVIEW_DATE

            MENUITEM "&Tid",                        ID_VIEW_REMOTELISTVIEW_TIME

            MENUITEM "&Tillatelser",                ID_VIEW_REMOTELISTVIEW_PERMISSIONS

            MENUITEM "&Eier / Gruppe",              ID_VIEW_REMOTELISTVIEW_OWNERGROUP

            MENUITEM SEPARATOR
            MENUITEM "&Vis statuslinje",            ID_MENU_VIEW_REMOTELISTVIEW_STATUSBAR

            POPUP "Sorter &etter..."
            BEGIN
                MENUITEM "&Filnavn",                    ID_MENU_VIEW_REMOTELISTVIEW_SORTBY_FILENAME

                MENUITEM "Fil&størrelse",               ID_MENU_VIEW_REMOTELISTVIEW_SORTBY_FILESIZE

                MENUITEM "Fil&type",                    ID_MENU_VIEW_REMOTELISTVIEW_SORTBY_FILETYPE

                MENUITEM "&Dato / tid",                 ID_MENU_VIEW_REMOTELISTVIEW_SORTBY_DATETIME

                MENUITEM SEPARATOR
                MENUITEM "&Økende",                     ID_MENU_VIEW_REMOTELISTVIEW_SORTBY_ASCENDING

                MENUITEM "S&ynkende",                   ID_MENU_VIEW_REMOTELISTVIEW_SORTBY_DESCENDING

            END
        END
    END
    POPUP "&Kø"
    BEGIN
        MENUITEM "&Start overføringer i kø",    ID_MENU_QUEUE_PROCESSNOW
        MENUITEM "&Bruk flere tilkoblinger",    ID_MENU_QUEUE_USEMULTIPLE
        MENUITEM SEPARATOR
        MENUITEM "&Eksporter...",               ID_MENU_QUEUE_EXPORT
        MENUITEM "&Importer...",                ID_MENU_QUEUE_IMPORT
    END
    POPUP "&Server"
    BEGIN
        MENUITEM "&Endre passord...",           ID_MENU_SERVER_CHANGEPASS
        MENUITEM "&Kjør FTP kommando...\tCtrl+F", 
                                                ID_MENU_SERVER_ENTERRAWCOMMAND

        MENUITEM "Kopier &URL til clipboard",   ID_MENU_SERVER_COPYURLTOCLIPBOARD

    END
    POPUP "&Hjelp"
    BEGIN
        MENUITEM "&Innhold...",                 ID_HELPMENU_CONTENTS
        MENUITEM "&Søk...",                     ID_HELPMENU_SEARCH
        MENUITEM "I&ndeks...",                  ID_HELPMENU_INDEX
        MENUITEM SEPARATOR
        MENUITEM "&Om FileZilla...",            ID_APP_ABOUT
    END
END

IDR_OUTPUTCONTEXT MENU 
BEGIN
    POPUP "OutputContext"
    BEGIN
        MENUITEM "&Skriv inn kommando...",      ID_OUTPUTCONTEXT_ENTERCOMMAND

        MENUITEM SEPARATOR
        MENUITEM "&Kopier til clipboard",       ID_OUTPUTCONTEXT_COPYTOCLIPBOARD

        MENUITEM "&Slett &alt",                 ID_OUTPUTCONTEXT_CLEARALL
    END
END

IDR_FTPCONTEXTMENU MENU 
BEGIN
    POPUP "FtpContext"
    BEGIN
        MENUITEM "&Last ned",                   ID_FTPCONTEXT_DOWNLOAD
        MENUITEM "Legg til i &kø",              ID_FTPCONTEXT_ADDTOQUEUE
        MENUITEM "Last ned &som...",            ID_FTPCONTEXT_DOWNLOADAS
        MENUITEM SEPARATOR
        MENUITEM "&Åpne",                       ID_FTPCONTEXT_OPEN
        MENUITEM "&Vis/editer",                 ID_FTPCONTEXT_VIEWEDIT
        MENUITEM "&Ny mappe",                   ID_FTPCONTEXT_CREATEDIR
        MENUITEM "&Fjern",                      ID_FTPCONTEXT_DELETE
        MENUITEM "&Gi nytt navn",               ID_FTPCONTEXT_RENAME
        MENUITEM "&Filattributter",             ID_FTPCONTEXT_ATTRIBUTES
    END
END

IDR_LOCALCONTEXTMENU MENU 
BEGIN
    POPUP "LocalContext"
    BEGIN
        MENUITEM "&Last opp",                   ID_LOCALCONTEXT_UPLOAD
        MENUITEM "Legg til i &kø",              ID_LOCALCONTEXT_ADDTOQUEUE
        MENUITEM "Last opp &som...",            ID_LOCALCONTEXT_UPLOADAS
        MENUITEM SEPARATOR
        MENUITEM "&Ny mappe",                   ID_LOCALCONTEXT_CREATEDIRECTORY

        MENUITEM SEPARATOR
        MENUITEM "&Åpne",                       ID_LOCALCONTEXT_OPEN
        MENUITEM "&Vis/editer",                 ID_LOCALCONTEXT_VIEWEDIT
        MENUITEM "&Fjern",                      ID_LOCALCONTEXT_DELETE
        MENUITEM "&Gi nytt navn",               ID_LOCALCONTEXT_RENAME
        MENUITEM "&Egenskaper",                 ID_LOCALCONTEXT_PROPERTIES
    END
END

IDR_QUEUECONTEXTMENU MENU 
BEGIN
    POPUP "QueueContext"
    BEGIN
        MENUITEM "&Start overføringer i kø",    ID_QUEUECONTEXT_PROCESSQUEUE
        MENUITEM "&Fjern fra kø",               ID_QUEUECONTEXT_REMOVEFROMQUEUE

        MENUITEM "Nullstill stat&us",           ID_QUEUECONTEXT_RESETSTATUS
        MENUITEM SEPARATOR
        MENUITEM "&Pause",                      ID_QUEUECONTEXT_PAUSE
        MENUITEM "&Fortsett (Resume)",          ID_QUEUECONTEXT_RESUME
        MENUITEM "&Avbryt",                     ID_QUEUECONTEXT_ABORT
        MENUITEM SEPARATOR
        MENUITEM "Flytt &opp",                  ID_QUEUECONTEXT_MOVEUP
        MENUITEM "Flytt &ned",                  ID_QUEUECONTEXT_MOVEDOWN
        MENUITEM "Flytt til &topp",             ID_QUEUECONTEXT_MOVETOTOP
        MENUITEM "Flytt til &bunn",             ID_QUEUECONTEXT_MOVETOBOTTOM
    END
END

IDR_SITEMANAGER MENU 
BEGIN
    POPUP "&Fil"
    BEGIN
        MENUITEM "&Importer",                   ID_SITEMANAGER_FILE_IMPORT
        POPUP "&Eksporter..."
        BEGIN
            MENUITEM "som &URL liste",              ID_SITEMANAGER_FILE_EXPORT_ASURLLIST

            MENUITEM "med alle &detaljer",          ID_SITEMANAGER_FILE_EXPORT_WITHALLDETAILS

        END
        MENUITEM SEPARATOR
        MENUITEM "Lagre og &lukk",              ID_SITEMANAGER_SAVEEXIT
    END
END

