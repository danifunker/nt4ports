                    BS_AUTORADIOBUTTON | WS_GROUP,158,119,41,10
    CONTROL         "No&rmal",IDC_MANUALTRANSFER_LOGONTYPE2,"Button",
                    BS_AUTORADIOBUTTON,228,119,38,10
