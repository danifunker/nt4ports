IDD_OPTIONS_TRANSFER_COMPRESSION DIALOGEX 0, 0, 286, 222
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CONTROL | WS_CHILD
FONT 8, "MS Shell Dlg", 0, 0, 0x0
BEGIN
    LTEXT           "Using the MODE Z ftp protocol extension it is possible to use compressed file transfers on servers which support it.",
                    IDC_STATIC,7,7,272,18
    CONTROL         "Don't use compression",
                    IDC_OPTIONS_TRANSFER_COMPRESSION_USECOMPRESSION,"Button",
                    BS_AUTORADIOBUTTON | WS_GROUP,7,28,87,10
    CONTROL         "Use compression only for directory listings",
                    IDC_OPTIONS_TRANSFER_COMPRESSION_USECOMPRESSION2,"Button",
                    BS_AUTORADIOBUTTON,7,40,150,10
    CONTROL         "Use compression for all transfers",
                    IDC_OPTIONS_TRANSFER_COMPRESSION_USECOMPRESSION3,"Button",
                    BS_AUTORADIOBUTTON,7,52,121,10
    LTEXT           "Compression level, ranging from 1 (worst) to 9 (best):",
                    IDC_STATIC,7,72,174,8
    EDITTEXT        IDC_OPTIONS_TRANSFER_COMPRESSION_LEVEL,183,70,15,14,
                    ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "The default compression level is 8. It's a good tradeoff between the amount compression achieved and CPU usage.",
                    IDC_STATIC,7,84,272,18
    LTEXT           "For details about the compression method, please read http://www.ietf.org/internet-drafts/draft-preston-ftpext-deflate-02.txt",
                    IDC_STATIC,7,195,272,20
END


