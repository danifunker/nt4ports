                    ES_AUTOHSCROLL
    CONTROL         "&Bruk nåværende server",IDC_MANUALTRANSFER_SERVER1,
                    "Button",BS_AUTORADIOBUTTON | WS_GROUP,147,30,91,10
    CONTROL         "Bruk &følgende server:",IDC_MANUALTRANSFER_SERVER2,
                    "Button",BS_AUTORADIOBUTTON,147,41,83,10,
                    WS_EX_TRANSPARENT
    GROUPBOX        "¨",IDC_STATIC,141,41,170,164,WS_GROUP
    LTEXT           "&Server:",IDC_STATIC,148,52,24,8
    EDITTEXT        IDC_MANUALTRANSFER_HOST,148,61,127,14,ES_AUTOHSCROLL
