STRINGTABLE 
BEGIN
    IDS_QUESTION_BREAKCONNECTION "Avbryt gjeldende tilkobling?"
    IDS_QUESTION_CANCELOPERATION "Virkelig avbryte nåværende operasjon?"
    IDS_QUESTION_DELETEDIRS "Virkelig slette %d mapper?"
    IDS_QUESTION_DELETEFILE "Virkelig slette ""%s""?"
