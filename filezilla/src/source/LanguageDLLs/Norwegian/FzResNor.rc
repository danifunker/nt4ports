IDD_OPTIONS_SSHPAGE DIALOG  0, 0, 286, 208
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT           "FileZilla bruker deler av PuTTY(http://www.chiark.greenend.org.uk/~sgtatham/putty/) for SFTP tilkoblinger.",
                    IDC_STATIC,7,7,272,17
    LTEXT           "For å etablere SSH tilkoblinger til SFTP servere bruker FileZilla standardinnstillingene til PuTTY. Her kan du endre noen av disse innstillingene.",
                    IDC_STATIC,7,23,272,19
    LTEXT           "Bruk &kompresjon:",IDC_STATIC,7,45,56,8
    CONTROL         "Standard",IDC_OPTIONS_SSHPAGE_COMPRESSION1,"Button",
                    BS_AUTORADIOBUTTON | WS_GROUP,14,55,45,10
    CONTROL         "Ja",IDC_OPTIONS_SSHPAGE_COMPRESSION2,"Button",
                    BS_AUTORADIOBUTTON,74,55,23,10
    CONTROL         "Nei",IDC_OPTIONS_SSHPAGE_COMPRESSION3,"Button",
                    BS_AUTORADIOBUTTON,134,55,27,10
    LTEXT           "Protokolltype:",IDC_STATIC,7,68,44,8
    LTEXT           "Som standard (hvis du ikke har endret dette selv), bruker PuTTY SSH2 for tilkobling til SFTP servere.",
                    IDC_STATIC,14,80,265,17
    LTEXT           "Mens SSH2 er sikrere enn SSH1 har SSH2 implementasjonen i PuTTY noen fartsproblemer. (Se http://www.chiark.greenend.org.uk/~sgtatham/putty/wishlist/ sftp-slow.html for detaljer)",
                    IDC_STATIC,14,96,265,32
    LTEXT           "Hvis du opplever fartsproblemer med SFTP servere i FileZilla og du ikke trenger den ekstra sikkerheten SSH2 tilbyr, kan du tvinge bruk av SSH1 her.",
                    IDC_STATIC,14,128,265,17
    CONTROL         "Standard",IDC_OPTIONS_SSHPAGE_PROTOCOL1,"Button",
                    BS_AUTORADIOBUTTON | WS_GROUP,14,146,45,10
    CONTROL         "Bruk SSH1",IDC_OPTIONS_SSHPAGE_PROTOCOL2,"Button",
                    BS_AUTORADIOBUTTON,74,146,51,10
    CONTROL         "Bruk SSH2",IDC_OPTIONS_SSHPAGE_PROTOCOL3,"Button",
                    BS_AUTORADIOBUTTON,134,146,51,10
    LTEXT           "Husk at ikke alle servere støtter dette.",IDC_STATIC,14,
                    156,120,8
END

