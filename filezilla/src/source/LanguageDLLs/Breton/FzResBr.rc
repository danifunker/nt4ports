IDD_OPTIONS_SSHPAGE DIALOG  0, 0, 286, 208
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT           "Imlijout a ra FileZilla ul lodenn eus PuTTY (http://www.chiark.greenend.org.uk/~sgtatham/putty/) evit ar c'hennaskañ SFTP.",
                    IDC_STATIC,7,7,272,17
    LTEXT           "A-benn ober ar c'hennaskañ SSH gant an dafariadoù SFTP e implij FileZilla dibaboù PuTTY dre-ziouer. Amañ e c'hellit cheñch ul lodenn eus an diababoù-mañ.",
                    IDC_STATIC,7,23,272,19
    LTEXT           "&Gwaskañ ar stlennadoù :",IDC_STATIC,7,45,99,8
    CONTROL         "Diouer",IDC_OPTIONS_SSHPAGE_COMPRESSION1,"Button",
                    BS_AUTORADIOBUTTON | WS_GROUP,14,55,37,10
    CONTROL         "Ya",IDC_OPTIONS_SSHPAGE_COMPRESSION2,"Button",
                    BS_AUTORADIOBUTTON,74,55,27,10
    CONTROL         "Ket",IDC_OPTIONS_SSHPAGE_COMPRESSION3,"Button",
                    BS_AUTORADIOBUTTON,134,55,29,10
    LTEXT           "Diuz ar protokol :",IDC_STATIC,7,68,76,8
    LTEXT           "Ma n'ho peus kemmet ar perzhioù dre-ziouer e ra PuTTY gant ar protokol SSH2 evit kennaskañ ouzh an dafariadoù SSH.",
                    IDC_STATIC,14,80,265,17
    LTEXT           "Suroc'h eo e pep keñver ar protokol SSH1, koulskoude implij ar protokol SSH2 e-barzh PuTTY en deus kudennoù tizh. (Kit da http://www.chiark.greenend.org.uk/~sgtatham/putty/wishlist/sftp-slow.html evit lenn muioc'h a vunudoù)",
                    IDC_STATIC,14,96,265,32
    LTEXT           "M'en deus FileZilla kudennoù tizh gant an dafariadoù SFTP ha ma n'ho peus ezhomm d'ar surentez uhelañ SSH2, chomit gant implij ar protokol SSH1.",
                    IDC_STATIC,14,128,265,17
    CONTROL         "Diouer",IDC_OPTIONS_SSHPAGE_PROTOCOL1,"Button",
                    BS_AUTORADIOBUTTON | WS_GROUP,14,146,37,10
    CONTROL         "Implijout SSH1",IDC_OPTIONS_SSHPAGE_PROTOCOL2,"Button",
                    BS_AUTORADIOBUTTON,74,146,57,10
    CONTROL         "Implijout SSH2",IDC_OPTIONS_SSHPAGE_PROTOCOL3,"Button",
                    BS_AUTORADIOBUTTON,134,146,57,10
    LTEXT           "Diwallit 'ta, n'eo ket skoret an traoù-mañ gant lod a zafariadoù.",
                    IDC_STATIC,14,156,196,8
END

