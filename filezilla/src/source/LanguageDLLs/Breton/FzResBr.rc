IDD_OPTIONS_FIREWALL DIALOG  0, 0, 286, 208
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CONTROL | WS_CHILD
FONT 8, "MS Shell Dlg"
BEGIN
    CONTROL         "Mod &gouzañvat",IDC_OPTIONS_FIREWALL_PASV,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,7,103,82,10
    LTEXT           "Ma c'hellit bezañ kennasket ouzh an dafariadoù FTP met ne deu ket mat treuzkas ar restroù, e tlefe deoc'h gweredekaat ar mod gouzañvat.",
                    IDC_STATIC,7,82,272,17
    LTEXT           "Implijout a ra FileZilla dre-ziouer n'eus forzh peseurt porzh lec'hel a vez kavet gantañ evit ober ar c'hennaskañ hag an treuzkasoù. Ma fell deoc'h e vefe implijet gant FileZilla nemet ur skeuliadig porzhioù, lakait ar skeuliadig-mañ er maeziennomù a heul.",
                    IDC_STATIC,7,16,272,24
    CONTROL         "&Harzañ ar porzhioù lec'hel implijet gant FileZilla",
                    IDC_OPTIONS_FIREWALL_LIMITPORTS,"Button",BS_AUTOCHECKBOX | 
