        END
    END
    POPUP "&Lostennad"
    BEGIN
        MENUITEM "Keweriañ al &lostennad",      ID_MENU_QUEUE_PROCESSNOW
        MENUITEM "&Implijout ar c'hennaskañ &liezek", 
