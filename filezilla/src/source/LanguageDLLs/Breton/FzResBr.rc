IDD_OPTIONS_TRANSFER_COMPRESSION DIALOG  0, 0, 286, 222
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CONTROL | WS_CHILD
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT           "P'eo bet implijet astenn ""MODE Z"" ar protokol FTP eo posubl treuzkas restroù gwasket war an dafariad a skor anezhañ.",
                    IDC_STATIC,7,7,272,18
