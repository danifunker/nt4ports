        MENUITEM SEPARATOR
        MENUITEM "&Kuitaat",                    ID_TRAY_EXIT
    END
END

IDR_MAINFRAME MENU 
BEGIN
    POPUP "&Restr"
    BEGIN
        MENUITEM "Ardoer-&loadoù",              ID_SITEMANAGER
        MENUITEM "&Kopiañ ar c'hennaskañ e-barzh an Ardoer-loadoù", 
                                                ID_COPYTOSITEMANAGER
        MENUITEM "&Kennaskañ ouzh al load dre-ziouer", 
                                                ID_FILE_CONNECTTODEFAULTSITE
        MENUITEM SEPARATOR
        MENUITEM "&Adkennaskañ",                ID_TOOLBAR_RECONNECT
        MENUITEM "&Digennaskañ",                ID_TOOLBAR_DISCONNECT
        MENUITEM SEPARATOR
        MENUITEM "&Kuitaat",                    ID_APP_EXIT
    END
    POPUP "&Embann"
    BEGIN
        MENUITEM "&Dibaboù && Perzhioù",        ID_EDIT_SETTINGS
        MENUITEM "E&zporzhiañ ar perzhioù",     ID_EDIT_EXPORTSETTINGS
        MENUITEM "&Enporzhiañ ar perzhioù",     ID_EDIT_IMPORTSETTINGS
    END
    POPUP "&Treuzkas"
    BEGIN
        POPUP "&Rizh an treuzkas"
        BEGIN
            MENUITEM "&ASCII",                      ID_TYPEMENU_ASCII
            MENUITEM "&Daouek",                     ID_TYPEMENU_BINARY
            MENUITEM "E&mgefre",                    ID_TYPEMENU_DETECT
        END
        POPUP "Flastrañ ar &restroù"
        BEGIN
            MENUITEM "&Goulenn",                    ID_OVERWRITEMENU_ASK
            MENUITEM SEPARATOR
            MENUITEM "&Flastrañ",                   ID_OVERWRITEMENU_OVERWRITE

            MENUITEM "Flastrañ mard eo &freskoc'h", ID_OVERWRITEMENU_OVERWRITEIFNEWER

            MENUITEM "&Kenderc'hel",                ID_OVERWRITEMENU_RESUME
            MENUITEM "Ad&envel",                    ID_OVERWRITEMENU_RENAME
            MENUITEM "Tre&men",                     ID_OVERWRITEMENU_SKIP
        END
        MENUITEM SEPARATOR
        MENUITEM "Treuzkas dre-&zorn",          ID_MENU_TRANSFER_MANUALTRANSFER

    END
    POPUP "G&wereañ"
    BEGIN
        MENUITEM "&Freskaat ar gwelioù",        ID_TOOLBAR_REFRESH
        MENUITEM "&Diskouez ar restroù kuzhet", ID_MENU_VIEW_SHOWHIDDEN
        MENUITEM SEPARATOR
        MENUITEM "&Barrenn ostilhoù",           ID_VIEW_TOOLBAR
        MENUITEM "Barrenn &stad",               ID_VIEW_STATUS_BAR
        MENUITEM "Barrenn gennaskañ &brim",     ID_VIEW_QUICKCONNECT_BAR
        MENUITEM SEPARATOR
        MENUITEM "Treug &lec'hel",              ID_SHOWTREE
        MENUITEM "Treug &arbell",               ID_SHOWREMOTETREE
        MENUITEM "Kerzh-levr &kemennadoù",      ID_VIEW_MESSAGELOG
        MENUITEM "&Lostennad an treuzkasadennoù", ID_SHOWQUEUE
        MENUITEM SEPARATOR
        POPUP "Gwel ar roll &lec'hel"
        BEGIN
            MENUITEM "&Munudoù",                    ID_LOCALLISTSTYLE_REPORT
            MENUITEM "&Roll",                       ID_LOCALLISTSTYLE_LIST
            MENUITEM "Arlunioù &bras",              ID_LOCALLISTSTYLE_ICON
            MENUITEM "Ar&lunioù bihan",             ID_LOCALLISTSTYLE_SMALLICON

            MENUITEM SEPARATOR
            MENUITEM "&Ment ar restroù",            ID_VIEW_LOCALLISTVIEW_FILESIZE

            MENUITEM "Riz&h",                       ID_VIEW_LOCALLISTVIEW_FILETYPE

            MENUITEM "Eur &kemmañ",                 ID_VIEW_LOCALLISTVIEW_LASTMODIFIEDTIME

            MENUITEM SEPARATOR
            MENUITEM "&Diskouez ar varrenn stad",   ID_MENU_VIEW_LOCALLISTVIEW_STATUSBAR

            POPUP "Rummañ &diouzh..."
            BEGIN
                MENUITEM "&Anv",                        ID_MENU_VIEW_LOCALLISTVIEW_SORTBY_FILENAME

                MENUITEM "&Ment",                       ID_MENU_VIEW_LOCALLISTVIEW_SORTBY_FILESIZE

                MENUITEM "&Rizh",                       ID_MENU_VIEW_LOCALLISTVIEW_SORTBY_FILETYPE

                MENUITEM "&Kemmañ diwezhañ",            ID_MENU_VIEW_LOCALLISTVIEW_SORTBY_LASTMODIFIED

                MENUITEM SEPARATOR
                MENUITEM "&War-gresk",                  ID_MENU_VIEW_LOCALLISTVIEW_SORTBY_ASCENDING

                MENUITEM "&War-zigresk",                ID_MENU_VIEW_LOCALLISTVIEW_SORTBY_DESCENDING

            END
        END
        POPUP "Gwel ar roll &arbell"
        BEGIN
            MENUITEM "&Munudoù",                    ID_REMOTELISTSTYLE_REPORT

            MENUITEM "Rol&l",                       ID_REMOTELISTSTYLE_LIST
            MENUITEM "&Arlunioù bras",              ID_REMOTELISTSTYLE_ICON
            MENUITEM "Arlunioù &bihan",             ID_REMOTELISTSTYLE_SMALLICON

            MENUITEM SEPARATOR
            MENUITEM "&Ment ar restroù",            ID_VIEW_REMOTELISTVIEW_FILESIZE

            MENUITEM "Rizh ar &restr",              ID_VIEW_REMOTELISTVIEW_FILETYPE

            MENUITEM "&Deiziad",                    ID_VIEW_REMOTELISTVIEW_DATE

            MENUITEM "&Eur",                        ID_VIEW_REMOTELISTVIEW_TIME

            MENUITEM "Aotre&gezhioù",               ID_VIEW_REMOTELISTVIEW_PERMISSIONS

            MENUITEM "&Perc'henn / strollad",       ID_VIEW_REMOTELISTVIEW_OWNERGROUP

            MENUITEM SEPARATOR
            MENUITEM "Diskouez ar &varrenn stad",   ID_MENU_VIEW_REMOTELISTVIEW_STATUSBAR

            POPUP "Rummañ &diouzh..."
            BEGIN
                MENUITEM "&Anv",                        ID_MENU_VIEW_REMOTELISTVIEW_SORTBY_FILENAME

                MENUITEM "&Ment",                       ID_MENU_VIEW_REMOTELISTVIEW_SORTBY_FILESIZE

                MENUITEM "&Rizh",                       ID_MENU_VIEW_REMOTELISTVIEW_SORTBY_FILETYPE

                MENUITEM "&Deiziad / Eur",              ID_MENU_VIEW_REMOTELISTVIEW_SORTBY_DATETIME

                MENUITEM SEPARATOR
