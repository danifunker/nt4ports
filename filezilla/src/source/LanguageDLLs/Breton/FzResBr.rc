        MENUITEM "&Nullañ",                     ID_QUEUECONTEXT_ABORT
        MENUITEM SEPARATOR
        MENUITEM "&Uheloc'h",                   ID_QUEUECONTEXT_MOVEUP
        MENUITEM "&Izeloc'h",                   ID_QUEUECONTEXT_MOVEDOWN
        MENUITEM "An &uhelañ",                  ID_QUEUECONTEXT_MOVETOTOP
        MENUITEM "An &izellañ",                 ID_QUEUECONTEXT_MOVETOBOTTOM
    END
END

IDR_SITEMANAGER MENU 
BEGIN
    POPUP "&Restr"
    BEGIN
        MENUITEM "&Enporzhiañ",                 ID_SITEMANAGER_FILE_IMPORT
        POPUP "&Ezporzhiañ..."
        BEGIN
            MENUITEM "evel ul rollad &URLioù",      ID_SITEMANAGER_FILE_EXPORT_ASURLLIST

            MENUITEM "gant an holl &vunudoù ennañ", ID_SITEMANAGER_FILE_EXPORT_WITHALLDETAILS

        END
        MENUITEM SEPARATOR
        MENUITEM "Gwarediñ ha &Kuitaat",        ID_SITEMANAGER_SAVEEXIT
    END
END

IDR_LOCALTREECONTEXTMENU MENU 
BEGIN
    POPUP "LocalTreeContext"
    BEGIN
        MENUITEM "&Kargañ war an dafariad",     ID_LOCALTREECONTEXT_UPLOAD
        MENUITEM "&Ouzhennañ d'al lostennad",   ID_LOCALTREECONTEXT_ADDTOQUEUE

        MENUITEM "Kargañ &dindan...",           ID_LOCALTREECONTEXT_UPLOADAS
        MENUITEM SEPARATOR
        MENUITEM "&Dilemel",                    ID_LOCALTREECONTEXT_DELETE
        MENUITEM "&Adenvel",                    ID_LOCALTREECONTEXT_RENAME
    END
END


