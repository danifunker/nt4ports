    CONTROL         "Gwaskañ ar stlennadoù evit pep treuzkas",
                    IDC_OPTIONS_TRANSFER_COMPRESSION_USECOMPRESSION3,"Button",
                    BS_AUTORADIOBUTTON,7,52,215,10
