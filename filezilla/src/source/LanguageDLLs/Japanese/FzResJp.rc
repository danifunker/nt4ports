// Version
//

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 2,2,12,0
 PRODUCTVERSION 2,2,12,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x4L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "000004b0"
        BEGIN
            VALUE "Comments", "Japanese"
            VALUE "FileDescription", "Japanese language DLL for FileZilla"
            VALUE "FileVersion", "2, 2, 12, 0"
            VALUE "InternalName", "FileZilla"
            VALUE "LegalCopyright", "Copyright (C) 2001-2003 by Tim Kosse under the GPL"
            VALUE "OriginalFilename", "FileZilla.EXE"
            VALUE "ProductName", "FileZilla Language DLL"
            VALUE "ProductVersion", "2, 2, 12, 0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0, 1200
    END
END


