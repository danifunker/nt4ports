IDD_OPTIONS_FIREWALL DIALOGEX 0, 0, 286, 208
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CONTROL | WS_CHILD
FONT 9, "MS Shell Dlg", 400, 0, 0x80
BEGIN
    CONTROL         "FileZillaが使用するローカルポートを制限する(&L)",
                    IDC_OPTIONS_FIREWALL_LIMITPORTS,"Button",BS_AUTOCHECKBOX | 
                    WS_TABSTOP,7,7,145,10
    LTEXT           "デフォルトではFileZillaは利用可能な全てのローカルポートを接続の確立と転送に使用します. もしFileZillaに小さな範囲のポートだけを使わせたいならば, 下にポートの範囲を入力して下さい.",
                    IDC_STATIC,19,17,260,24
    LTEXT           "利用可能な最低のポート(&w):",IDC_STATIC,19,45,83,8
