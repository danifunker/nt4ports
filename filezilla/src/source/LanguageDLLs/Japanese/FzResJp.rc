                    ES_AUTOHSCROLL
    LTEXT           "利用可能な最大のポート(&H):",IDC_STATIC,19,62,82,8
    EDITTEXT        IDC_OPTIONS_FIREWALL_RANGEHIGH,102,59,40,14,
                    ES_AUTOHSCROLL
    LTEXT           "もしftpサーバに接続はできるがファイルの転送ができない場合, パッシブモードを有効にしてみて下さい.",
                    IDC_STATIC,7,88,272,17
    CONTROL         "パッシブモード(&P)",IDC_OPTIONS_FIREWALL_PASV,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,7,106,61,10
    CONTROL         "パッシブでない転送のために下記のIPアドレスを使用(&U):",
                    IDC_OPTIONS_FIREWALL_USETRANSFERIP,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,7,125,167,10
    EDITTEXT        IDC_OPTIONS_FIREWALL_TRANSFERIP,19,137,60,14,
                    ES_AUTOHSCROLL
    CONTROL         "IPv6を使用していたらパッシブでない転送のために下記のIPアドレスを使用(&U):",
                    IDC_OPTIONS_FIREWALL_USETRANSFERIP_IPV6,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,7,158,225,10
    EDITTEXT        IDC_OPTIONS_FIREWALL_TRANSFERIP_IPV6,19,171,60,14,
                    ES_AUTOHSCROLL
END

