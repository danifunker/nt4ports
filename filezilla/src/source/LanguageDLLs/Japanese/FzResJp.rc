IDD_MANUALTRANSFER DIALOGEX 0, 0, 318, 212
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | 
    WS_SYSMENU
CAPTION "手動ファイル転送の設定"
FONT 9, "MS Shell Dlg", 400, 0, 0x80
BEGIN
    LTEXT           "カスタマイズされたファイル転送の設定をします. できるだけ情報を入力して下さい. もし空欄のままであれば, FileZillaがそれらを埋めようとします.",
                    IDC_STATIC,7,7,304,17
    LTEXT           "転送の種類:",IDC_STATIC,7,28,36,8
    CONTROL         "ダウンロード(&D)",IDC_MANUALTRANSFER_UPDOWN1,"Button",
                    BS_AUTORADIOBUTTON | WS_GROUP,7,38,57,10
    CONTROL         "アップロード(&U)",IDC_MANUALTRANSFER_UPDOWN2,"Button",
                    BS_AUTORADIOBUTTON,7,49,55,10
    LTEXT           "ローカルファイル(&L):",IDC_STATIC,7,65,54,8
    EDITTEXT        IDC_MANUALTRANSFER_LOCALFILE,7,74,125,14,ES_AUTOHSCROLL
    LTEXT           "リモートファイル(&R):",IDC_STATIC,7,93,52,8
    EDITTEXT        IDC_MANUALTRANSFER_REMOTEFILE,7,103,125,14,
                    ES_AUTOHSCROLL
    CONTROL         "現在のサーバを使用(&c)",IDC_MANUALTRANSFER_SERVER1,
                    "Button",BS_AUTORADIOBUTTON | WS_GROUP,147,28,81,10
    CONTROL         "下記のサーバを使用(&f)",IDC_MANUALTRANSFER_SERVER2,
                    "Button",BS_AUTORADIOBUTTON,147,39,79,10,
                    WS_EX_TRANSPARENT
    GROUPBOX        "",IDC_STATIC,141,39,170,166,WS_GROUP
    LTEXT           "ホスト(&H):",IDC_STATIC,148,52,29,8
    EDITTEXT        IDC_MANUALTRANSFER_HOST,148,61,127,14,ES_AUTOHSCROLL
    LTEXT           "ポート(&P):",IDC_STATIC,281,52,29,8
    EDITTEXT        IDC_MANUALTRANSFER_PORT,280,61,25,14,ES_AUTOHSCROLL | 
                    ES_NUMBER
    LTEXT           "サーバの種類(&S):",IDC_STATIC,148,80,50,8
    COMBOBOX        IDC_MANUALTRANSFER_SERVERTYPE,148,90,157,49,
                    CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    GROUPBOX        "ログオンの種類",IDC_STATIC,148,108,157,38
    CONTROL         "匿名(&y)",IDC_MANUALTRANSFER_LOGONTYPE1,"Button",
                    BS_AUTORADIOBUTTON | WS_GROUP,158,119,39,10
    CONTROL         "通常(&o)",IDC_MANUALTRANSFER_LOGONTYPE2,"Button",
                    BS_AUTORADIOBUTTON,228,119,38,10
    CONTROL         "プロキシの設定を無視(&B)",
                    IDC_MANUALTRANSFER_BYPASSPROXY,"Button",BS_AUTOCHECKBOX | 
                    WS_GROUP | WS_TABSTOP,158,132,86,10
    LTEXT           "ユーザ(&e):",IDC_STATIC,148,149,30,8
    EDITTEXT        IDC_MANUALTRANSFER_USER,148,158,157,14,ES_AUTOHSCROLL
    LTEXT           "パスワード(&w):",IDC_STATIC,148,176,42,8
    EDITTEXT        IDC_MANUALTRANSFER_PASS,148,185,157,14,ES_PASSWORD | 
                    ES_AUTOHSCROLL
    DEFPUSHBUTTON   "OK",IDOK,15,191,50,14
    PUSHBUTTON      "キャンセル",IDCANCEL,75,191,50,14
    CONTROL         "今すぐ転送を開始(&n)",IDC_MANUALTRANSFER_STARTNOW,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,172,74,10
END

