/////////////////////////////////////////////////////////////////////////////
//
// Bitmap
//

IDR_MAINFRAME           BITMAP                  "res\\Toolbar.bmp"

/////////////////////////////////////////////////////////////////////////////
//
// Toolbar
//

IDR_MAINFRAME TOOLBAR  16, 16
BEGIN
    BUTTON      ID_SITEMANAGER
    SEPARATOR
    BUTTON      ID_SHOWTREE
    BUTTON      ID_SHOWREMOTETREE
    BUTTON      ID_SHOWQUEUE
    BUTTON      ID_VIEW_MESSAGELOG
    SEPARATOR
    BUTTON      ID_TOOLBAR_REFRESH
    BUTTON      ID_PROCESS_QUEUE
    BUTTON      ID_CANCELBUTTON
    BUTTON      ID_TOOLBAR_DISCONNECT
    BUTTON      ID_TOOLBAR_RECONNECT
    SEPARATOR
    BUTTON      ID_HELPMENU_CONTENTS
END


/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MAINFRAME MENU 
BEGIN
    POPUP "ファイル(&F)"
    BEGIN
        MENUITEM "サイトマネージャ(&S)...\tCtrl+S", ID_SITEMANAGER
        MENUITEM "接続をサイトマネージャにコピー(&C)", ID_COPYTOSITEMANAGER
        MENUITEM "デフォルトサイトに接続(&o)",  ID_FILE_CONNECTTODEFAULTSITE
        MENUITEM SEPARATOR
        MENUITEM "再接続(&R)\tCtrl+R",          ID_TOOLBAR_RECONNECT
        MENUITEM "切断(&D)\tCtrl+D",            ID_TOOLBAR_DISCONNECT
        MENUITEM SEPARATOR
        MENUITEM "終了(&x)",                    ID_APP_EXIT
    END
    POPUP "編集(&E)"
    BEGIN
        MENUITEM "設定(&S)...",                 ID_EDIT_SETTINGS
        MENUITEM "設定をエクスポート(&x)...",   ID_EDIT_EXPORTSETTINGS
        MENUITEM "設定をインポート(&I)...",     ID_EDIT_IMPORTSETTINGS
    END
    POPUP "転送(&T)"
    BEGIN
        POPUP "転送の種類(&T)"
        BEGIN
            MENUITEM "&ASCII",                      ID_TYPEMENU_ASCII
            MENUITEM "&Binary",                     ID_TYPEMENU_BINARY
            MENUITEM "自動(&u)",                    ID_TYPEMENU_DETECT
        END
        POPUP "ファイルの上書き設定(&F)"
        BEGIN
            MENUITEM "尋ねる(&A)",                  ID_OVERWRITEMENU_ASK
            MENUITEM SEPARATOR
            MENUITEM "上書き(&O)",                  ID_OVERWRITEMENU_OVERWRITE

            MENUITEM "新しければ上書き(&i)",        ID_OVERWRITEMENU_OVERWRITEIFNEWER

            MENUITEM "レジューム(&R)",              ID_OVERWRITEMENU_RESUME
            MENUITEM "名前の変更(&n)",              ID_OVERWRITEMENU_RENAME
            MENUITEM "スキップ(&S)",                ID_OVERWRITEMENU_SKIP
        END
        MENUITEM SEPARATOR
        MENUITEM "手動ファイル転送(&M)...",     ID_MENU_TRANSFER_MANUALTRANSFER

    END
    POPUP "ビュー(&V)"
    BEGIN
        MENUITEM "ビューを更新(&R)\t     F5",   ID_TOOLBAR_REFRESH
        MENUITEM "隠しファイルを表示する(&h)",  ID_MENU_VIEW_SHOWHIDDEN
        MENUITEM SEPARATOR
        MENUITEM "ツールバー(&T)",              ID_VIEW_TOOLBAR
        MENUITEM "ステータスバー(&S)",          ID_VIEW_STATUS_BAR
        MENUITEM "クイック接続バー(&C)",        ID_VIEW_QUICKCONNECT_BAR
        MENUITEM SEPARATOR
        MENUITEM "ローカルツリービュー(&L)\tCtrl+T", ID_SHOWTREE
        MENUITEM "リモートツリービュー(&o)",    ID_SHOWREMOTETREE
        MENUITEM "メッセージログ(&M)",          ID_VIEW_MESSAGELOG
        MENUITEM "転送キュー(&Q)",              ID_SHOWQUEUE
        MENUITEM SEPARATOR
        POPUP "ローカルリストビュー(&a)"
        BEGIN
            MENUITEM "詳細(&D)",                    ID_LOCALLISTSTYLE_REPORT
            MENUITEM "一覧(&L)",                    ID_LOCALLISTSTYLE_LIST
            MENUITEM "大きいアイコン(&I)",          ID_LOCALLISTSTYLE_ICON
            MENUITEM "小さいアイコン(&c)",          ID_LOCALLISTSTYLE_SMALLICON

            MENUITEM SEPARATOR
            MENUITEM "ファイルサイズ(&z)",          ID_VIEW_LOCALLISTVIEW_FILESIZE

            MENUITEM "ファイルタイプ(&t)",          ID_VIEW_LOCALLISTVIEW_FILETYPE

            MENUITEM "最終更新時刻(&m)",            ID_VIEW_LOCALLISTVIEW_LASTMODIFIEDTIME

            MENUITEM SEPARATOR
            MENUITEM "ステータスバーを表示(&S)",    ID_MENU_VIEW_LOCALLISTVIEW_STATUSBAR

            POPUP "整列(&o)..."
            BEGIN
                MENUITEM "ファイル名(&F)",              ID_MENU_VIEW_LOCALLISTVIEW_SORTBY_FILENAME

                MENUITEM "ファイルサイズ(&s)",          ID_MENU_VIEW_LOCALLISTVIEW_SORTBY_FILESIZE

                MENUITEM "ファイルの種類(&t)",          ID_MENU_VIEW_LOCALLISTVIEW_SORTBY_FILETYPE

                MENUITEM "最終更新(&L)",                ID_MENU_VIEW_LOCALLISTVIEW_SORTBY_LASTMODIFIED

                MENUITEM SEPARATOR
                MENUITEM "昇順(&A)",                    ID_MENU_VIEW_LOCALLISTVIEW_SORTBY_ASCENDING

                MENUITEM "降順(&D)",                    ID_MENU_VIEW_LOCALLISTVIEW_SORTBY_DESCENDING

            END
        END
        POPUP "リモートリストビュー(&e)"
        BEGIN
            MENUITEM "詳細(&D)",                    ID_REMOTELISTSTYLE_REPORT

            MENUITEM "一覧(&L)",                    ID_REMOTELISTSTYLE_LIST
            MENUITEM "大きいアイコン(&I)",          ID_REMOTELISTSTYLE_ICON
            MENUITEM "小さいアイコン(&c)",          ID_REMOTELISTSTYLE_SMALLICON

            MENUITEM SEPARATOR
            MENUITEM "ファイルサイズ(&z)",          ID_VIEW_REMOTELISTVIEW_FILESIZE

            MENUITEM "ファイルの種類(&y)",          ID_VIEW_REMOTELISTVIEW_FILETYPE

            MENUITEM "日付(&a)",                    ID_VIEW_REMOTELISTVIEW_DATE

            MENUITEM "時刻(&T)",                    ID_VIEW_REMOTELISTVIEW_TIME

            MENUITEM "パーミッション(&P)",          ID_VIEW_REMOTELISTVIEW_PERMISSIONS

            MENUITEM "所有者 / グループ(&O)",       ID_VIEW_REMOTELISTVIEW_OWNERGROUP

            MENUITEM SEPARATOR
            MENUITEM "ステータスバーを表示(&S)",    ID_MENU_VIEW_REMOTELISTVIEW_STATUSBAR

            POPUP "整列(&b)..."
            BEGIN
                MENUITEM "ファイル名(&F)",              ID_MENU_VIEW_REMOTELISTVIEW_SORTBY_FILENAME

                MENUITEM "ファイルサイズ(&s)",          ID_MENU_VIEW_REMOTELISTVIEW_SORTBY_FILESIZE

                MENUITEM "ファイルの種類(&t)",          ID_MENU_VIEW_REMOTELISTVIEW_SORTBY_FILETYPE

                MENUITEM "日付 / 時刻(&D)",             ID_MENU_VIEW_REMOTELISTVIEW_SORTBY_DATETIME

                MENUITEM SEPARATOR
                MENUITEM "昇順(&A)",                    ID_MENU_VIEW_REMOTELISTVIEW_SORTBY_ASCENDING

                MENUITEM "降順(&e)",                    ID_MENU_VIEW_REMOTELISTVIEW_SORTBY_DESCENDING

            END
        END
    END
    POPUP "キュー(&Q)"
    BEGIN
        MENUITEM "キューを処理(&P)",            ID_MENU_QUEUE_PROCESSNOW
        MENUITEM "多重接続を使用(&U)",          ID_MENU_QUEUE_USEMULTIPLE
        MENUITEM SEPARATOR
        MENUITEM "エクスポート(&E)...",         ID_MENU_QUEUE_EXPORT
        MENUITEM "インポート(&I)...",           ID_MENU_QUEUE_IMPORT
    END
    POPUP "サーバ(&S)"
    BEGIN
        MENUITEM "パスワードの変更(&C)...",     ID_MENU_SERVER_CHANGEPASS
        MENUITEM "raw FTPコマンドを入力(&E)...\tCtrl+F", 
                                                ID_MENU_SERVER_ENTERRAWCOMMAND

        MENUITEM "URLをクリップボードにコピー(&U)", 
                                                ID_MENU_SERVER_COPYURLTOCLIPBOARD

    END
    POPUP "ヘルプ(&H)"
    BEGIN
        MENUITEM "目次(&C)...",                 ID_HELPMENU_CONTENTS
        MENUITEM "検索(&S)...",                 ID_HELPMENU_SEARCH
        MENUITEM "インデックス...",             ID_HELPMENU_INDEX
        MENUITEM SEPARATOR
        MENUITEM "FileZillaについて(&A)...",    ID_APP_ABOUT
    END
END

IDR_OUTPUTCONTEXT MENU 
BEGIN
    POPUP "OutputContext"
    BEGIN
        MENUITEM "コマンドを入力(&E)...",       ID_OUTPUTCONTEXT_ENTERCOMMAND

        MENUITEM SEPARATOR
        MENUITEM "クリップボードにコピー(&o)",  ID_OUTPUTCONTEXT_COPYTOCLIPBOARD

        MENUITEM "全てクリア(&C)",              ID_OUTPUTCONTEXT_CLEARALL
    END
END

IDR_FTPCONTEXTMENU MENU 
BEGIN
    POPUP "FtpContext"
    BEGIN
        MENUITEM "ダウンロード(&D)",            ID_FTPCONTEXT_DOWNLOAD
        MENUITEM "キューに追加(&A)",            ID_FTPCONTEXT_ADDTOQUEUE
        MENUITEM "別名でダウンロード(&w)...",   ID_FTPCONTEXT_DOWNLOADAS
        MENUITEM SEPARATOR
        MENUITEM "開く(&O)",                    ID_FTPCONTEXT_OPEN
        MENUITEM "閲覧 / 編集(&V)",             ID_FTPCONTEXT_VIEWEDIT
        MENUITEM "ディレクトリを作成(&C)",      ID_FTPCONTEXT_CREATEDIR
        MENUITEM "削除(&e)",                    ID_FTPCONTEXT_DELETE
        MENUITEM "名前の変更(&R)",              ID_FTPCONTEXT_RENAME
        MENUITEM "ファイルの属性(&F)...",       ID_FTPCONTEXT_ATTRIBUTES
    END
END

IDR_LOCALCONTEXTMENU MENU 
BEGIN
    POPUP "LocalContext"
    BEGIN
        MENUITEM "アップロード(&U)",            ID_LOCALCONTEXT_UPLOAD
        MENUITEM "キューに追加(&A)",            ID_LOCALCONTEXT_ADDTOQUEUE
        MENUITEM "別名でアップロード(&p)...",   ID_LOCALCONTEXT_UPLOADAS
        MENUITEM SEPARATOR
        MENUITEM "ディレクトリを作成(&C)",      ID_LOCALCONTEXT_CREATEDIRECTORY

        MENUITEM SEPARATOR
        MENUITEM "開く(&O)",                    ID_LOCALCONTEXT_OPEN
        MENUITEM "閲覧 / 編集(&V)",             ID_LOCALCONTEXT_VIEWEDIT
        MENUITEM "削除(&e)",                    ID_LOCALCONTEXT_DELETE
        MENUITEM "名前の変更(&R)",              ID_LOCALCONTEXT_RENAME
        MENUITEM "プロパティ(&t)",              ID_LOCALCONTEXT_PROPERTIES
    END
END

IDR_QUEUECONTEXTMENU MENU 
BEGIN
    POPUP "QueueContext"
    BEGIN
        MENUITEM "キューを処理(&P)",            ID_QUEUECONTEXT_PROCESSQUEUE
        MENUITEM "キューから削除(&R)",          ID_QUEUECONTEXT_REMOVEFROMQUEUE

        MENUITEM "状態をリセット(&S)",          ID_QUEUECONTEXT_RESETSTATUS
        MENUITEM SEPARATOR
        MENUITEM "一時停止(&e)",                ID_QUEUECONTEXT_PAUSE
        MENUITEM "レジューム(&m)",              ID_QUEUECONTEXT_RESUME
        MENUITEM "中止(&A)",                    ID_QUEUECONTEXT_ABORT
        MENUITEM SEPARATOR
        MENUITEM "上に移動(&u)",                ID_QUEUECONTEXT_MOVEUP
        MENUITEM "下に移動(&d)",                ID_QUEUECONTEXT_MOVEDOWN
        MENUITEM "最上位に移動(&t)",            ID_QUEUECONTEXT_MOVETOTOP
        MENUITEM "最下位に移動(&b)",            ID_QUEUECONTEXT_MOVETOBOTTOM
    END
END

IDR_SITEMANAGER MENU 
BEGIN
    POPUP "ファイル(&F)"
    BEGIN
        MENUITEM "インポート(&I)",              ID_SITEMANAGER_FILE_IMPORT
        POPUP "エクスポート(&E)..."
        BEGIN
            MENUITEM "as &URL list",                ID_SITEMANAGER_FILE_EXPORT_ASURLLIST

            MENUITEM "with all &details",           ID_SITEMANAGER_FILE_EXPORT_WITHALLDETAILS

        END
        MENUITEM SEPARATOR
        MENUITEM "保存して終了(&x)",            ID_SITEMANAGER_SAVEEXIT
    END
END

IDR_LOCALTREECONTEXTMENU MENU 
BEGIN
    POPUP "LocalTreeContext"
    BEGIN
        MENUITEM "アップロード(&U)",            ID_LOCALTREECONTEXT_UPLOAD
        MENUITEM "キューに追加(&A)",            ID_LOCALTREECONTEXT_ADDTOQUEUE

        MENUITEM "別名でアップロード(&p)...",   ID_LOCALTREECONTEXT_UPLOADAS
        MENUITEM SEPARATOR
        MENUITEM "削除(&e)",                    ID_LOCALTREECONTEXT_DELETE
        MENUITEM "名前の変更(&R)",              ID_LOCALTREECONTEXT_RENAME
    END
END

IDR_SYSTRAY_MENU MENU 
BEGIN
    POPUP "POPUP"
    BEGIN
        MENUITEM "元に戻す(&R)",                ID_TRAY_RESTORE
        MENUITEM SEPARATOR
        MENUITEM "終了(&x)",                    ID_TRAY_EXIT
    END
END


