IDD_OPTIONS_SSHPAGE DIALOGEX 0, 0, 286, 208
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CONTROL | WS_CHILD
FONT 9, "MS Shell Dlg", 400, 0, 0x80
BEGIN
    LTEXT           "FileZillaはPuTTY(http://www.chiark.greenend.org.uk/~sgtatham/putty/)をSFTP接続のために一部使用しています.",
                    IDC_STATIC,7,7,272,17
    LTEXT           "SFTPサーバへのSSHの接続を確立するために, FileZillaはPuTTYのデフォルトオプションを使用します. このページでは幾つかのデフォルト設定を上書きできます.",
                    IDC_STATIC,7,23,272,19
    LTEXT           "圧縮を使用(&C):",IDC_STATIC,7,45,46,8
    CONTROL         "デフォルト",IDC_OPTIONS_SSHPAGE_COMPRESSION1,"Button",
                    BS_AUTORADIOBUTTON | WS_GROUP,14,55,41,10
    CONTROL         "Yes",IDC_OPTIONS_SSHPAGE_COMPRESSION2,"Button",
                    BS_AUTORADIOBUTTON,74,55,28,10
    CONTROL         "No",IDC_OPTIONS_SSHPAGE_COMPRESSION3,"Button",
                    BS_AUTORADIOBUTTON,134,55,25,10
    LTEXT           "プロトコルの選択:",IDC_STATIC,7,68,48,8
    LTEXT           "デフォルトでは(デフォルトの設定を変更していないなら), PuTTYはSSHサーバへの接続にSSH2を使用します.",
                    IDC_STATIC,14,80,265,17
    LTEXT           "PuTTYのSSH2の実装はSSH1よりもセキュアですが, 幾つかの速度的な問題を持っています. (詳細はhttp://www.chiark.greenend.org.uk/~sgtatham/putty/wishlist/sftp-slow.htmlを参照)",
                    IDC_STATIC,14,96,265,32
    LTEXT           "もしFileZillaでSFTPサーバに速度的な問題が有るならSSH2の追加的セキュリティを要求せずに, SSH1の使用を強制してみて下さい.",
                    IDC_STATIC,14,128,265,17
    CONTROL         "デフォルト",IDC_OPTIONS_SSHPAGE_PROTOCOL1,"Button",
                    BS_AUTORADIOBUTTON | WS_GROUP,14,146,41,10
    CONTROL         "SSH1を使用",IDC_OPTIONS_SSHPAGE_PROTOCOL2,"Button",
                    BS_AUTORADIOBUTTON,74,146,51,10
    CONTROL         "SSH2を使用",IDC_OPTIONS_SSHPAGE_PROTOCOL3,"Button",
                    BS_AUTORADIOBUTTON,134,146,51,10
    LTEXT           "全てのサーバがサポートしているわけではないという事を覚えておいて下さい",
                    IDC_STATIC,14,156,196,8
END

